# AI report (opcional; sin esto la opción 3 del menú avisa y no corre)
GEMINI_API_KEY=

# Fallbacks de datos de mercado. yfinance es el primario y no necesita key;
# estas se usan sólo si yfinance falla. Sin ninguna de las dos, si yfinance
# falla el script corta con error: nunca inventa datos.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# Notificaciones push (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Modelo local (OpenAI-compatible: LM Studio, llama.cpp server, vLLM, LocalAI…)
# Se usa para tareas baratas: extraer datos del texto pegado, digest del portfolio
# y reparar las sugerencias mal formateadas. Sin FA_LOCAL_AI_MODEL queda apagado.
FA_LOCAL_AI_URL=http://localhost:1234/v1
FA_LOCAL_AI_MODEL=
FA_LOCAL_AI_API_KEY=not-needed
FA_LOCAL_AI_TIMEOUT=240      # la primera llamada también carga el modelo en memoria
FA_LOCAL_AI_MAX_TOKENS=2000  # subilo si el modelo "razona" y se queda sin presupuesto

# Comportamiento
FA_DESKTOP_NOTIFICATIONS=true   # notify-send; poné false dentro de Docker
FA_COOLDOWN_HOURS=24            # horas mínimas entre repeticiones de una alerta
FA_EARNINGS_WARNING_DAYS=7      # antelación por defecto del aviso de earnings
FA_BENCHMARK=SPY                # índice contra el que se mide la fuerza relativa (QQQ, IWM...)
FA_DATA_DIR=./data              # dónde viven la DB y alerts.log
